QWEN_GW_ATTEMPT_TS=0
QWEN_SEC_TOKEN_CACHE=''
QWEN_GW_USAGE=''
QWEN_GW_QCONF=''
QWEN_GW_SPEC=''
# Persisted gateway-reading summary (non-secret usage metadata only).
QWEN_PERSISTED_TS=0
QWEN_PERSISTED_P1W=''
QWEN_PERSISTED_P1WR=''
QWEN_PERSISTED_P5=''
QWEN_PERSISTED_P5R=''
QWEN_PERSISTED_SPEC=''
QWEN_PERSISTED_CEILW=''
QWEN_PERSISTED_CEIL5=''
# Calibration anchor: the last same-window gateway reading plus the meter total
# at that instant; rate is credits per token derived from two such readings.
QWEN_ANCHOR_TS=0
QWEN_ANCHOR_TOKENS=0
QWEN_ANCHOR_CREDITS=0
QWEN_ANCHOR_RESET=0
QWEN_RATE=''
FORCE_QWEN=0

qwen_cookie_args() {
  # Populate the named array with either an explicitly supplied Cookie header
  # or curl's cookie-file option. Never read cookie material into panel output.
  local -n target=$1
  local cookie_file
  target=()
  if [ -n "${TELEMETRY_QWEN_COOKIE:-}" ]; then
    target=(-H "Cookie: ${TELEMETRY_QWEN_COOKIE}")
    return 0
  fi
  cookie_file="${TELEMETRY_QWEN_COOKIE_FILE:-$TELEMETRY_HOME/.local/state/qq/telemetry/qwen.cookies}"
  if [ -f "$cookie_file" ]; then
    # shellcheck disable=SC2034 # target is the caller's nameref output array.
    target=(-b "$cookie_file")
    return 0
  fi
  return 1
}

qwen_sec_token() {
  # Resolve the gateway token: env override wins, then the process-cached
  # token, then a fresh user/info round-trip. The gateway clears the cache
  # when the usage call fails so an expired token refreshes on the next
  # attempt. Runs in the calling shell (nameref), so the cache persists.
  local -n out=$1
  if [ -n "${TELEMETRY_QWEN_SEC_TOKEN:-}" ]; then
    out="$TELEMETRY_QWEN_SEC_TOKEN"
    return 0
  fi
  if [ -n "$QWEN_SEC_TOKEN_CACHE" ]; then
    out="$QWEN_SEC_TOKEN_CACHE"
    return 0
  fi
  local -a cookie_args=()
  qwen_cookie_args cookie_args || return 1
  out=$(api_get 'https://home.qwencloud.com/tool/user/info.json' "${cookie_args[@]}" |
    jq -r '.data.secToken // empty' 2>/dev/null || true)
  [ -n "$out" ] && QWEN_SEC_TOKEN_CACHE="$out"
}

qwen_gateway_fetch() {
  local sec endpoint
  local -a cookie_args=()
  [ -n "$TELEMETRY_TMP" ] || return 1
  qwen_cookie_args cookie_args || return 1
  qwen_sec_token sec || return 1
  [ -n "$sec" ] || return 1

  # usage and quota-config are required; subscription is best-effort (its
  # specCode falls back to TELEMETRY_QWEN_TIER). A failed usage call clears
  # the cached token so the next attempt refetches it.
  for endpoint in usage quota-config; do
    curl -sS -L -m 8 -X POST 'https://cs-data.qwencloud.com/data/api.json' \
      -H 'Content-Type: application/x-www-form-urlencoded' \
      -H 'Origin: https://home.qwencloud.com' \
      -H 'Referer: https://home.qwencloud.com/billing/subscription/token-plan-individual' \
      "${cookie_args[@]}" \
      --data-urlencode 'product=sfm_bailian' \
      --data-urlencode 'action=IntlBroadScopeAspnGateway' \
      --data-urlencode "sec_token=$sec" \
      --data-urlencode 'region=ap-southeast-1' \
      --data-urlencode "params={\"Api\":\"zeldaHttp.apikeyMgr./tokenplan/personal/api/v2/$endpoint\",\"Data\":{\"cornerstoneParam\":{\"domain\":\"home.qwencloud.com\",\"consoleSite\":\"QWENCLOUD\",\"console\":\"ONE_CONSOLE\",\"xsp_lang\":\"en-US\",\"protocol\":\"V2\",\"productCode\":\"p_efm\"}},\"V\":\"1.0\"}" \
      >"$TELEMETRY_TMP/$endpoint" 2>/dev/null || {
        [ "$endpoint" = usage ] && QWEN_SEC_TOKEN_CACHE=''
        return 1
      }
    jq -e '.data.DataV2.data.data != null' "$TELEMETRY_TMP/$endpoint" >/dev/null 2>&1 || {
      [ "$endpoint" = usage ] && QWEN_SEC_TOKEN_CACHE=''
      return 1
    }
  done
  curl -sS -L -m 8 -X POST 'https://cs-data.qwencloud.com/data/api.json' \
    -H 'Content-Type: application/x-www-form-urlencoded' \
    -H 'Origin: https://home.qwencloud.com' \
    -H 'Referer: https://home.qwencloud.com/billing/subscription/token-plan-individual' \
    "${cookie_args[@]}" \
    --data-urlencode 'product=sfm_bailian' \
    --data-urlencode 'action=IntlBroadScopeAspnGateway' \
    --data-urlencode "sec_token=$sec" \
    --data-urlencode 'region=ap-southeast-1' \
    --data-urlencode "params={\"Api\":\"zeldaHttp.apikeyMgr./tokenplan/personal/api/v2/subscription\",\"Data\":{\"cornerstoneParam\":{\"domain\":\"home.qwencloud.com\",\"consoleSite\":\"QWENCLOUD\",\"console\":\"ONE_CONSOLE\",\"xsp_lang\":\"en-US\",\"protocol\":\"V2\",\"productCode\":\"p_efm\"}},\"V\":\"1.0\"}" \
    >"$TELEMETRY_TMP/subscription" 2>/dev/null || true
}

qwen_meter() {
  local sessions="$TELEMETRY_HOME/.pi/agent/sessions" state_dir cache_work
  local changed_list matched_lines scanned_json totals nowms cutoff7 cutoff5
  local -a changed_files=()
  [ -d "$sessions" ] || { QWEN_METER_AVAILABLE=0; return 1; }
  [ -n "$TELEMETRY_TMP" ] || { QWEN_METER_AVAILABLE=0; return 1; }

  state_dir=$(dirname -- "$METER_CACHE")
  mkdir -p -- "$state_dir" 2>/dev/null || { QWEN_METER_AVAILABLE=0; return 1; }
  cache_work="$TELEMETRY_TMP/meter-cache-source.json"
  changed_list="$TELEMETRY_TMP/meter-changed.txt"
  matched_lines="$TELEMETRY_TMP/meter-qwen-lines.txt"
  scanned_json="$TELEMETRY_TMP/meter-scanned.json"
  manifest_file="$state_dir/meter-manifest.tsv"
  cache_invalid=0
  if [ -r "$METER_CACHE" ] && jq -e '
      type == "object" and
      (.version | type) == "number" and
      .version == 2
    ' "$METER_CACHE" >/dev/null 2>&1; then
    cp -- "$METER_CACHE" "$cache_work"
  else
    # Version 2 stores only events selected by the exact top-level message
    # provider. Unversioned/older entries may contain pre-fix false matches, so
    # starting with an empty cache deliberately forces one full corpus rescan.
    printf '{"version":2}\n' >"$cache_work"
    cache_invalid=1
  fi

  nowms=$(( $(now_epoch) * 1000 ))
  cutoff7=$(( nowms - QWEN_SESSION_WINDOW_DAYS * 24 * 3600 * 1000 ))
  cutoff5=$(( nowms - 5 * 3600 * 1000 ))

  # One find pass feeds a single awk that truncates fractional mtimes, diffs
  # against the previous tick's manifest, emits changed/removed paths, and
  # writes the new manifest. Generated Pi session paths contain neither tabs
  # nor newlines, so the manifest is a plain path\tmtime\tsize TSV kept next
  # to the cache. The previous manifest is preloaded with getline (not
  # NR==FNR, which misbehaves when the manifest is empty on the first run).
  [ -f "$manifest_file" ] || : >"$manifest_file"
  find "$sessions" -type f -name '*.jsonl' -printf '%p\t%T@\t%s\n' 2>/dev/null \
    | awk -F '\t' -v manifest_out="$manifest_file" -v prevfile="$manifest_file" '
        BEGIN {
          while ((getline line < prevfile) > 0) {
            n = split(line, f, "\t")
            if (n >= 3) prev[f[1]] = f[2] "\t" f[3]
          }
          close(prevfile)
        }
        { sub(/\..*/, "", $2) }
        $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ {
          cur[$1] = $2 FS $3
          if (prev[$1] != cur[$1]) print $1
        }
        END {
          for (p in prev) if (!(p in cur)) print p
          for (p in cur) print p "\t" cur[p] > manifest_out
        }
      ' - >"$changed_list"
  mapfile -t changed_files <"$changed_list"

  # Idle tick: nothing changed, the cache is current, and totals are known.
  if [ "${#changed_files[@]}" -eq 0 ] && [ "$cache_invalid" = 0 ] && [ "${QWEN_METER_INIT:-0}" = 1 ]; then
    return 0
  fi

  : >"$matched_lines"
  if [ "${#changed_files[@]}" -gt 0 ]; then
    grep -H -E '"provider"[[:space:]]*:[[:space:]]*"qwen-token-plan"' \
      "${changed_files[@]}" >"$matched_lines" 2>/dev/null || true
  fi
  if [ -s "$matched_lines" ]; then
    jq -Rn --argjson cutoff7 "$cutoff7" '
    reduce inputs as $raw ({};
      ($raw | index(":")) as $separator |
      if $separator == null then . else
        ($raw[0:$separator]) as $path |
        (try ($raw[$separator + 1:] | fromjson) catch null) as $message |
        if $message == null then . else
          .[$path] = (.[$path] // {events: [], walls: []}) |
          if ($message.message.provider == "qwen-token-plan" and
              $message.message.stopReason != "error" and
              ($message.message.timestamp | type) == "number" and
              ($message.message.usage.totalTokens | type) == "number" and
              $message.message.timestamp >= $cutoff7) then
            .[$path].events += [[$message.message.timestamp, $message.message.usage.totalTokens]]
          elif ($message.message.provider == "qwen-token-plan" and
              $message.message.stopReason == "error" and
              (($message.message.errorMessage // "") |
                test("quota has been exhausted"; "i")) and
              ($message.message.timestamp // 0) >= $cutoff7) then
            .[$path].walls += [{timestamp: ($message.message.timestamp // 0), text: "quota exhausted"}]
          elif ($message.message.provider == "qwen-token-plan" and
              $message.message.stopReason == "error" and
              (($message.message.errorMessage // "") |
                test("insufficient_quota"; "i")) and
              ($message.message.timestamp // 0) >= $cutoff7) then
            .[$path].walls += [{timestamp: ($message.message.timestamp // 0), text: "insufficient quota"}]
          else . end
        end
      end)
  ' <"$matched_lines" >"$scanned_json" || { QWEN_METER_AVAILABLE=0; return 1; }
  else
    printf '{}\n' >"$scanned_json"
  fi

  jq -n --argjson cutoff7 "$cutoff7" --argjson cutoff5 "$cutoff5" \
    --rawfile manifest "$manifest_file" --slurpfile old "$cache_work" --slurpfile scanned "$scanned_json" '
      def canonical_wall:
        (.text // "") as $text |
        if ($text | test("quota has been exhausted|^quota exhausted$"; "i")) then
          {timestamp: .timestamp, text: "quota exhausted"}
        elif ($text | test("insufficient_quota|^insufficient quota$"; "i")) then
          {timestamp: .timestamp, text: "insufficient quota"}
        else empty end;
      (($manifest | split("\n")) | map(select(length > 0)) | map(split("\t") | select(length >= 3) | {key: .[0], mtime: (.[1] | tonumber), size: (.[2] | tonumber)})) as $files |
      reduce ($files[]) as $file ({version: 2};
        ($old[0][$file.key] // {}) as $cached |
        (($cached.mtime != $file.mtime) or
          ($cached.size != $file.size) or
          (($cached.events | type) != "array") or
          (($cached.walls | type) != "array")) as $changed |
        (if $changed then ($scanned[0][$file.key] // {events: [], walls: []}) else $cached end) as $source |
        [$source.events[]? | select(.[0] >= $cutoff7)] as $events |
        [$source.walls[]? | select((.timestamp | type) == "number" and .timestamp >= $cutoff7) | canonical_wall] as $walls |
        .[$file.key] = {
          mtime: $file.mtime,
          size: $file.size,
          sum7d: ([$events[]? | .[1]] | add // 0),
          sum5h: ([$events[]? | select(.[0] >= $cutoff5) | .[1]] | add // 0),
          events: $events,
          walls: $walls
        })
  ' >"$TELEMETRY_TMP/meter-cache-new.json" || { QWEN_METER_AVAILABLE=0; return 1; }
  chmod 600 "$TELEMETRY_TMP/meter-cache-new.json" 2>/dev/null || true
  mv -f -- "$TELEMETRY_TMP/meter-cache-new.json" "$METER_CACHE" || {
    QWEN_METER_AVAILABLE=0
    return 1
  }

  totals=$(jq -r '
    def entries: to_entries[] | select(.key != "version") | .value;
    ([entries | .sum5h // 0] | add // 0),
    ([entries | .sum7d // 0] | add // 0),
    ([entries | .walls[]?] | sort_by(.timestamp) | (last.text // "")),
    ([entries | .walls[]?] | sort_by(.timestamp) | (last.timestamp // 0))
  ' "$METER_CACHE" 2>/dev/null) || { QWEN_METER_AVAILABLE=0; return 1; }
  QWEN_MTR_T5=$(sed -n '1p' <<<"$totals")
  QWEN_MTR_T7=$(sed -n '2p' <<<"$totals")
  QWEN_WALL_TEXT=$(sed -n '3p' <<<"$totals")
  QWEN_WALL_TS=$(sed -n '4p' <<<"$totals")
  QWEN_METER_INIT=1
  QWEN_METER_AVAILABLE=1
}

fmt_age() {
  local s="$1" h m
  [ "$s" -lt 0 ] && s=0
  h=$((s / 3600))
  m=$(((s % 3600) / 60))
  if [ "$h" -gt 0 ]; then
    if [ "$m" -gt 0 ]; then printf '%dh %dm ago' "$h" "$m"; else printf '%dh ago' "$h"; fi
  else
    printf '%ds ago' "$s"
  fi
}

qwen_gateway_state_load() {
  # Read the persisted non-secret gateway summary (last reading + calibration
  # anchor + rate) so a fresh panel launch during an outage still has data.
  # Malformed or missing state fails closed with empty vars.
  local f="$GW_STATE_FILE"
  [ -r "$f" ] || return 1
  [ ! -L "$f" ] || return 1
  jq -e '
    .version == 1 and
    ((.ts | type) == "number") and
    ((.p1w | type) == "number") and
    ((.p1wr | type) == "number") and
    ((.ceilw | type) == "number") and
    (.anchor == null or ((.anchor | type) == "object" and (.anchor.ts | type) == "number")) and
    (.rate == null or (.rate | type) == "number")
  ' "$f" >/dev/null 2>&1 || return 1
  QWEN_PERSISTED_TS=$(jq -r '.ts' "$f")
  QWEN_PERSISTED_P1W=$(jq -r '.p1w // empty' "$f")
  QWEN_PERSISTED_P1WR=$(jq -r '.p1wr // empty' "$f")
  QWEN_PERSISTED_P5=$(jq -r '.p5 // empty' "$f")
  QWEN_PERSISTED_P5R=$(jq -r '.p5r // empty' "$f")
  QWEN_PERSISTED_SPEC=$(jq -r '.spec // empty' "$f")
  QWEN_PERSISTED_CEILW=$(jq -r '.ceilw // empty' "$f")
  QWEN_PERSISTED_CEIL5=$(jq -r '.ceil5 // empty' "$f")
  QWEN_ANCHOR_TS=$(jq -r '.anchor.ts // 0' "$f")
  QWEN_ANCHOR_TOKENS=$(jq -r '.anchor.tokens // 0' "$f")
  QWEN_ANCHOR_CREDITS=$(jq -r '.anchor.credits // 0' "$f")
  QWEN_ANCHOR_RESET=$(jq -r '.anchor.reset // 0' "$f")
  QWEN_RATE=$(jq -r '.rate // empty' "$f")
}

qwen_gateway_state_save() {
  # Persist usage metadata only (percentages, ceilings, reset times, anchor,
  # rate). Never payload text, tokens, cookies, or gateway secrets.
  local tmp="$TELEMETRY_TMP/qwen-gateway.json" state_dir
  [ -n "$TELEMETRY_TMP" ] || return 1
  state_dir=$(dirname -- "$GW_STATE_FILE")
  mkdir -p -- "$state_dir" 2>/dev/null || return 1
  jq -n --argjson ts "$QWEN_PERSISTED_TS" \
       --argjson p1w "${QWEN_PERSISTED_P1W:-0}" --argjson p1wr "${QWEN_PERSISTED_P1WR:-0}" \
       --argjson p5 "${QWEN_PERSISTED_P5:-null}" --argjson p5r "${QWEN_PERSISTED_P5R:-null}" \
       --arg spec "$QWEN_PERSISTED_SPEC" \
       --argjson ceilw "${QWEN_PERSISTED_CEILW:-0}" --argjson ceil5 "${QWEN_PERSISTED_CEIL5:-0}" \
       --argjson ats "$QWEN_ANCHOR_TS" --argjson atok "$QWEN_ANCHOR_TOKENS" \
       --argjson acr "$QWEN_ANCHOR_CREDITS" --argjson ars "$QWEN_ANCHOR_RESET" \
       --argjson rate "${QWEN_RATE:-null}" \
    '{version: 1, ts: $ts, p1w: $p1w, p1wr: $p1wr, p5: $p5, p5r: $p5r, spec: $spec,
      ceilw: $ceilw, ceil5: $ceil5,
      anchor: {ts: $ats, tokens: $atok, credits: $acr, reset: $ars},
      rate: $rate}' >"$tmp" 2>/dev/null || return 1
  chmod 600 "$tmp" 2>/dev/null || true
  mv -f -- "$tmp" "$GW_STATE_FILE" || return 1
}

qwen_render_rows() {
  # Build the standard 7d/5h rows (bar, used/limit, reset) from gateway values.
  # dim=1 renders fully dimmed rows for a stale last reading, with the optional
  # note (e.g. the age) appended inside the dim span; the EXHAUSTED wall flag
  # stays colored in both styles.
  local p1w="$1" p1wr="$2" p5="$3" p5r="$4" ceilw="$5" ceil5="$6" dim="${7:-0}" note="${8:-}" observed_ts="${9:-0}"
  local usage_state="${10:-ready}" tokenw used5 col flag weekly_inactive=0 weekly_reset five_reset
  QWEN_L1='7d       unavailable'
  QWEN_L2=''
  QWEN_USAGE_STATE=unavailable
  QWEN_USAGE_OBSERVED_AT=''
  QWEN_WEEKLY_RATIO=''
  QWEN_WEEKLY_RESET_AT=''
  QWEN_WEEKLY_DETAIL=''
  QWEN_FIVE_RATIO=''
  QWEN_FIVE_RESET_AT=''
  QWEN_FIVE_DETAIL=''
  if [[ "$p1w" =~ ^[0-9]+([.][0-9]+)?$ && "$ceilw" =~ ^[0-9]+$ ]]; then
    if [[ "$p1wr" =~ ^[0-9]+$ ]]; then
      weekly_reset="reset $(epoch_local "$((p1wr / 1000))")"
    elif [ "$(awk -v p="$p1w" 'BEGIN { print (p==0) ? 1 : 0 }')" = 1 ]; then
      # Qwen omits reset timestamps immediately after renewal until the first
      # request starts the new quota windows. Zero usage is still live truth.
      weekly_inactive=1
      weekly_reset='window not started'
    else
      weekly_reset=''
    fi
    if [ -n "$weekly_reset" ]; then
      tokenw=$(awk -v p="$p1w" -v c="$ceilw" 'BEGIN { printf "%d", p*c }')
      QWEN_USAGE_STATE=$usage_state
      [[ "$observed_ts" =~ ^[0-9]+$ ]] && [ "$observed_ts" -gt 0 ] && QWEN_USAGE_OBSERVED_AT=$((observed_ts * 1000))
      QWEN_WEEKLY_RATIO=$p1w
      [[ "$p1wr" =~ ^[0-9]+$ ]] && QWEN_WEEKLY_RESET_AT=$p1wr
      QWEN_WEEKLY_DETAIL="$tokenw / $ceilw"
      flag="$(exhausted_flag "$p1w" "$QWEN_WALL_TEXT" "$QWEN_WALL_TS" "$observed_ts")"
      if [ "$dim" = 1 ]; then
        QWEN_L1="${C_DIM}7d       $(bar "$p1w") $(fmt_num "$tokenw") / $(fmt_num "$ceilw")   ${weekly_reset}  ${note}${C_RESET}"
      else
        col=$(color_frac "$p1w")
        QWEN_L1="7d       ${col}$(bar "$p1w")${C_RESET} ${col}$(fmt_num "$tokenw") / $(fmt_num "$ceilw")${C_RESET}   ${C_DIM}${weekly_reset}${C_RESET}"
      fi
      [ -n "$flag" ] && QWEN_L1+="  $flag"
    fi
  fi
  if [ "$weekly_inactive" = 1 ] && [ -z "$p5" ]; then
    p5=0
  fi
  if [[ "$p5" =~ ^[0-9]+([.][0-9]+)?$ && "$ceil5" =~ ^[0-9]+$ ]]; then
    if [[ "$p5r" =~ ^[0-9]+$ ]]; then
      five_reset="reset $(epoch_local "$((p5r / 1000))")"
    elif [ "$(awk -v p="$p5" 'BEGIN { print (p==0) ? 1 : 0 }')" = 1 ]; then
      five_reset='window not started'
    else
      five_reset=''
    fi
    if [ -n "$five_reset" ]; then
      used5=$(awk -v p="$p5" -v c="$ceil5" 'BEGIN { printf "%d", p*c }')
      QWEN_FIVE_RATIO=$p5
      [[ "$p5r" =~ ^[0-9]+$ ]] && QWEN_FIVE_RESET_AT=$p5r
      QWEN_FIVE_DETAIL="$used5 / $ceil5"
      if [ "$dim" = 1 ]; then
        QWEN_L2="${C_DIM}5h       $(bar "$p5") $(fmt_num "$used5") / $(fmt_num "$ceil5")   ${five_reset}${C_RESET}"
      else
        col=$(color_frac "$p5")
        QWEN_L2="5h       ${col}$(bar "$p5")${C_RESET} ${col}$(fmt_num "$used5") / $(fmt_num "$ceil5")${C_RESET}   ${C_DIM}${five_reset}${C_RESET}"
      fi
    fi
  fi
}

qwen_update() {
  local now="$1" age spec fetched=0
  local usage qconf p5 p1w p5r p1wr ceil5n ceilwn tokenw frac col flag projected
  QWEN_L1='7d       unavailable'
  QWEN_L2=''
  QWEN_USAGE_STATE=unavailable
  QWEN_USAGE_OBSERVED_AT=''
  QWEN_WEEKLY_RATIO=''
  QWEN_WEEKLY_RESET_AT=''
  QWEN_WEEKLY_DETAIL=''
  QWEN_FIVE_RATIO=''
  QWEN_FIVE_RESET_AT=''
  QWEN_FIVE_DETAIL=''

  qwen_gateway_state_load

  if [ "$((now - QWEN_MTR_TS))" -ge "$QWEN_MTR_CADENCE" ]; then
    qwen_meter || true
    QWEN_MTR_TS=$(now_epoch)
  fi

  if qwen_cookie_args _qwen_cookie_probe 2>/dev/null; then
    # Both clocks must be due: the success clock controls freshness labels,
    # while the attempt clock prevents a failed gateway from retrying each tick.
    if { [ "$((now - QWEN_GW_TS))" -ge "$QWEN_GW_CADENCE" ] &&
         [ "$((now - QWEN_GW_ATTEMPT_TS))" -ge "$QWEN_GW_CADENCE" ]; } ||
       [ "$FORCE_QWEN" = 1 ]; then
      QWEN_GW_ATTEMPT_TS=$now
      if qwen_gateway_fetch; then
        QWEN_GW_USAGE=$(cat "$TELEMETRY_TMP/usage")
        QWEN_GW_QCONF=$(cat "$TELEMETRY_TMP/quota-config")
        QWEN_GW_SPEC=$(jq -r '.data.DataV2.data.data.specCode // empty' "$TELEMETRY_TMP/subscription" 2>/dev/null || true)
        [ -n "$QWEN_GW_SPEC" ] || QWEN_GW_SPEC="${TELEMETRY_QWEN_TIER:-}"
        QWEN_GW_TS=$now
        fetched=1
      fi
      FORCE_QWEN=0
    fi
  fi

  spec="$QWEN_GW_SPEC"

  # State 1 — the gateway reading fetched this session, fresh within one
  # cadence, is vendor truth rendered in the standard row shape. It stays on
  # screen across the cadence instead of vanishing after a few seconds.
  if [ -n "$QWEN_GW_USAGE" ] && [ -n "$QWEN_GW_QCONF" ] && [ "$QWEN_GW_TS" -gt 0 ] && [ "$((now - QWEN_GW_TS))" -le "$QWEN_GW_CADENCE" ]; then
    usage="$QWEN_GW_USAGE"
    qconf="$QWEN_GW_QCONF"
    p5=$(jq -r '.data.DataV2.data.data.per5HourPercentage // empty' <<<"$usage" 2>/dev/null || true)
    p1w=$(jq -r '.data.DataV2.data.data.per1WeekPercentage // empty' <<<"$usage" 2>/dev/null || true)
    p5r=$(jq -r '.data.DataV2.data.data.per5HourResetTime // empty' <<<"$usage" 2>/dev/null || true)
    p1wr=$(jq -r '.data.DataV2.data.data.per1WeekResetTime // empty' <<<"$usage" 2>/dev/null || true)
    ceil5n=$(tier_ceiling "$qconf" "$spec" five_hour || true)
    ceilwn=$(tier_ceiling "$qconf" "$spec" weekly || true)
    qwen_render_rows "$p1w" "$p1wr" "$p5" "$p5r" "$ceilwn" "$ceil5n" 0 '' "$QWEN_GW_TS" ready
    if [ "$QWEN_L1" != '7d       unavailable' ]; then
      if [ "$fetched" = 1 ]; then
        tokenw=$(awk -v p="$p1w" -v c="$ceilwn" 'BEGIN { printf "%d", p*c }')
        # Refresh the persisted summary and calibrate: two same-window readings
        # (this one and the previous, in-session or from an earlier panel run)
        # give the credits-per-token rate that powers the live estimate.
        if [ "$QWEN_METER_AVAILABLE" = 1 ] && [ "$QWEN_METER_INIT" = 1 ] && [[ "$p1wr" =~ ^[0-9]+$ ]]; then
          if [ "$QWEN_ANCHOR_TS" -gt 0 ] && [ "$QWEN_ANCHOR_RESET" = "$p1wr" ]; then
            local delta_tokens delta_credits
            delta_tokens=$((QWEN_MTR_T7 - QWEN_ANCHOR_TOKENS))
            delta_credits=$((tokenw - QWEN_ANCHOR_CREDITS))
            if [ "$delta_tokens" -gt 0 ] && [ "$delta_credits" -ge 0 ]; then
              QWEN_RATE=$(awk -v d="$delta_credits" -v t="$delta_tokens" 'BEGIN { printf "%.9f", d/t }')
            else
              QWEN_RATE=''
            fi
          else
            QWEN_RATE=''
          fi
          QWEN_ANCHOR_TS=$(now_epoch)
          QWEN_ANCHOR_TOKENS=$QWEN_MTR_T7
          QWEN_ANCHOR_CREDITS=$tokenw
          QWEN_ANCHOR_RESET=$p1wr
        else
          QWEN_RATE=''
          if ! [[ "$p1wr" =~ ^[0-9]+$ ]]; then
            QWEN_ANCHOR_TS=0
            QWEN_ANCHOR_TOKENS=0
            QWEN_ANCHOR_CREDITS=0
            QWEN_ANCHOR_RESET=0
          fi
        fi
        QWEN_PERSISTED_TS=$now
        QWEN_PERSISTED_P1W=$p1w
        QWEN_PERSISTED_P1WR=$p1wr
        QWEN_PERSISTED_P5=$p5
        QWEN_PERSISTED_P5R=$p5r
        QWEN_PERSISTED_SPEC=$spec
        QWEN_PERSISTED_CEILW=$ceilwn
        QWEN_PERSISTED_CEIL5=$ceil5n
        qwen_gateway_state_save || true
      fi
      return
    fi
  fi

  # State 2 — gateway stale or unreachable; a calibrated anchor and rate turn
  # the live meter into a credit estimate that moves every tick.
  if [ -n "$QWEN_RATE" ] && [ "$QWEN_ANCHOR_TS" -gt 0 ] &&
     [ "$QWEN_METER_AVAILABLE" = 1 ] && [ "$QWEN_METER_INIT" = 1 ] &&
     [ -n "$QWEN_PERSISTED_CEILW" ] && [ -n "$QWEN_PERSISTED_P1WR" ] &&
     [ "$QWEN_ANCHOR_RESET" = "$QWEN_PERSISTED_P1WR" ] &&
     [ "$now" -le "$((QWEN_PERSISTED_P1WR / 1000))" ]; then
    projected=$(awk -v a="$QWEN_ANCHOR_CREDITS" -v r="$QWEN_RATE" -v t="$QWEN_MTR_T7" -v at="$QWEN_ANCHOR_TOKENS" \
      'BEGIN { v = a + r*(t-at); if (v < 0) v = 0; printf "%d", v }')
    frac=$(awk -v p="$projected" -v c="$QWEN_PERSISTED_CEILW" 'BEGIN { print (c>0) ? p/c : 0 }')
    col=$(color_frac "$frac")
    flag="$(exhausted_flag "$frac" "$QWEN_WALL_TEXT" "$QWEN_WALL_TS" "$QWEN_PERSISTED_TS")"
    QWEN_L1="7d       ${col}$(bar "$frac")${C_RESET} ${col}$(fmt_num "$projected") / $(fmt_num "$QWEN_PERSISTED_CEILW")${C_RESET}   ${C_DIM}reset $(epoch_local "$((QWEN_PERSISTED_P1WR / 1000))")${C_RESET}"
    QWEN_L1+="  ${C_DIM}~est${C_RESET}"
    [ -n "$flag" ] && QWEN_L1+="  $flag"
    if [[ "$QWEN_PERSISTED_CEIL5" =~ ^[0-9]+$ ]] && [ "$QWEN_PERSISTED_CEIL5" -gt 0 ]; then
      local est5 frac5
      est5=$(awk -v r="$QWEN_RATE" -v t="$QWEN_MTR_T5" 'BEGIN { v = r*t; printf "%d", v }')
      frac5=$(awk -v p="$est5" -v c="$QWEN_PERSISTED_CEIL5" 'BEGIN { print (c>0) ? p/c : 0 }')
      col=$(color_frac "$frac5")
      QWEN_L2="5h       ${col}$(bar "$frac5")${C_RESET} ${col}$(fmt_num "$est5") / $(fmt_num "$QWEN_PERSISTED_CEIL5")${C_RESET}"
      QWEN_FIVE_RATIO=$frac5
      [[ "$QWEN_PERSISTED_P5R" =~ ^[0-9]+$ ]] && QWEN_FIVE_RESET_AT=$QWEN_PERSISTED_P5R
      QWEN_FIVE_DETAIL="$est5 / $QWEN_PERSISTED_CEIL5 estimated"
    fi
    QWEN_USAGE_STATE=estimated
    QWEN_USAGE_OBSERVED_AT=$((QWEN_PERSISTED_TS * 1000))
    QWEN_WEEKLY_RATIO=$frac
    QWEN_WEEKLY_RESET_AT=$QWEN_PERSISTED_P1WR
    QWEN_WEEKLY_DETAIL="$projected / $QWEN_PERSISTED_CEILW estimated"
    return
  fi

  # State 3 — no calibration, but a last gateway reading still within its
  # window: dimmed real numbers with the age instead of an invented estimate.
  if [ -n "$QWEN_PERSISTED_P1W" ] && [ -n "$QWEN_PERSISTED_CEILW" ] && [ -n "$QWEN_PERSISTED_P1WR" ] &&
     [ "$QWEN_PERSISTED_TS" -gt 0 ] && [ "$now" -le "$((QWEN_PERSISTED_P1WR / 1000))" ]; then
    age=$((now - QWEN_PERSISTED_TS))
    [ "$age" -lt 0 ] && age=0
    qwen_render_rows "$QWEN_PERSISTED_P1W" "$QWEN_PERSISTED_P1WR" "$QWEN_PERSISTED_P5" "$QWEN_PERSISTED_P5R" "$QWEN_PERSISTED_CEILW" "$QWEN_PERSISTED_CEIL5" 1 "$(fmt_age "$age")" "$QWEN_PERSISTED_TS" stale
    return
  fi

  # State 4 — nothing usable; render unavailable like the other providers.
  # The meter never renders as a token count.
  QWEN_L1='7d       unavailable'
  flag="$(exhausted_flag 0 "$QWEN_WALL_TEXT")"
  [ -n "$flag" ] && QWEN_L1+="  $flag"
}

provider_stale_max_secs() {
  case "$1" in
    codex) printf '%s' "$CODEX_STALE_MAX_SECS" ;;
    grok) printf '%s' "$GROK_STALE_MAX_SECS" ;;
    *) return 1 ;;
  esac
}

provider_issue_text() {
  local provider=$1 issue=$2
  case "$issue" in
    login-required) printf 'run qq-models-login %s' "$provider" ;;
    configuration) printf 'check qq-models auth configuration' ;;
    provider-error) printf 'provider rejected usage request' ;;
    response-error) printf 'provider response unsupported' ;;
    temporary) printf 'temporary provider failure' ;;
    *) return 1 ;;
  esac
}

set_provider_issue() {
  local provider=$1 issue=$2 state row message
  case "$issue" in
    ''|login-required|configuration|provider-error|response-error|temporary) ;;
    *) issue=temporary ;;
  esac
  if [ "$provider" = codex ]; then
    CODEX_USAGE_ISSUE=$issue; state=$CODEX_USAGE_STATE
  else
    GROK_USAGE_ISSUE=$issue; state=$GROK_USAGE_STATE
  fi
  if [ "$state" = unavailable ]; then
    row='7d       unavailable'
    if [ -n "$issue" ] && message=$(provider_issue_text "$provider" "$issue"); then
      row+="   ${C_DIM}${message}${C_RESET}"
    fi
    if [ "$provider" = codex ]; then GPT_WEEK=$row; else GROK_WEEK=$row; fi
  elif [ "$state" = stale ] && [ -n "$issue" ] && [ "$issue" != temporary ]; then
    if message=$(provider_issue_text "$provider" "$issue"); then
      if [ "$provider" = codex ]; then
        GPT_WEEK+="   ${C_DIM}${message}${C_RESET}"
      else
        GROK_WEEK+="   ${C_DIM}${message}${C_RESET}"
      fi
    fi
  fi
}

set_provider_unavailable() {
  local provider=$1 issue=$2
  if [ "$provider" = codex ]; then
    CODEX_USAGE_STATE=unavailable
    CODEX_USAGE_OBSERVED_AT=''; CODEX_USAGE_RATIO=''; CODEX_USAGE_RESET_AT=''
  else
    GROK_USAGE_STATE=unavailable
    GROK_USAGE_OBSERVED_AT=''; GROK_USAGE_RATIO=''; GROK_USAGE_RESET_AT=''
  fi
  set_provider_issue "$provider" "$issue"
}

apply_provider_usage() {
  local provider=$1 state=$2 observed=$3 ratio=$4 reset=$5 nowms=$6
  local pct col row age
  pct=$(awk -v value="$ratio" 'BEGIN { printf "%.6g", value * 100 }')
  col=$(color_frac "$ratio")
  row="7d       ${col}$(bar "$ratio")${C_RESET} ${col}${pct}%${C_RESET}"
  if [ -n "$reset" ]; then
    row+="   ${C_DIM}reset $(epoch_local "$((reset / 1000))")${C_RESET}"
  fi
  if [ "$state" = stale ]; then
    age=$(( (nowms - observed) / 1000 ))
    row+="   ${C_DIM}stale $(fmt_age "$age")${C_RESET}"
  fi
  if [ "$provider" = codex ]; then
    GPT_WEEK=$row
    CODEX_USAGE_STATE=$state
    CODEX_USAGE_OBSERVED_AT=$observed
    CODEX_USAGE_RATIO=$ratio
    CODEX_USAGE_RESET_AT=$reset
    CODEX_USAGE_ISSUE=''
  else
    GROK_WEEK=$row
    GROK_USAGE_STATE=$state
    GROK_USAGE_OBSERVED_AT=$observed
    GROK_USAGE_RATIO=$ratio
    GROK_USAGE_RESET_AT=$reset
    GROK_USAGE_ISSUE=''
  fi
}

apply_provider_failure() {
  local provider=$1 issue=$2 state
  case "$issue" in
    login-required|configuration|provider-error|response-error|temporary) ;;
    *) issue=temporary ;;
  esac
  if [ "$provider" = codex ]; then state=$CODEX_USAGE_STATE; else state=$GROK_USAGE_STATE; fi
  if [ "$state" = stale ]; then
    set_provider_issue "$provider" "$issue"
  else
    set_provider_unavailable "$provider" "$issue"
  fi
}

provider_request_result() {
  local file=$1 result=''
  if [ -f "${file}.result" ] && [ ! -L "${file}.result" ]; then
    IFS= read -r result <"${file}.result" || result=''
  fi
  case "$result" in
    login-required|provider-error|temporary) printf '%s' "$result" ;;
    success) printf 'response-error' ;;
    *) printf 'temporary' ;;
  esac
}

load_stale_provider() {
  # Reuse only a strict prior row, preserving its original observation time.
  # Eligibility is bounded by the provider horizon and the prior quota reset.
  local provider=$1 nowms=$2 mode owner size row observed ratio reset horizon
  horizon=$(provider_stale_max_secs "$provider") || return 1
  [ -n "$USAGE_CACHE" ] && [[ "$USAGE_CACHE" == /* ]] || return 1
  [ -f "$USAGE_CACHE" ] && [ ! -L "$USAGE_CACHE" ] && [ -r "$USAGE_CACHE" ] || return 1
  read -r mode owner size < <(stat -c '%a %u %s' -- "$USAGE_CACHE" 2>/dev/null) || return 1
  [ "$mode" = 600 ] && [ "$owner" = "${EUID:-$(id -u)}" ] || return 1
  [[ "$size" =~ ^[0-9]+$ ]] && [ "$size" -gt 0 ] && [ "$size" -le "$MAX_USAGE_CACHE_BYTES" ] || return 1
  row=$(jq -er --arg provider "$provider" --argjson now "$nowms" \
      --argjson horizon "$((horizon * 1000))" '
    def finite: (isinfinite or isnan) | not;
    def epoch: type == "number" and finite and floor == . and . >= 0 and . <= 9007199254740991;
    if type != "object" or .schema != "qq.dashboard-usage/v1"
       or (.generatedAt | epoch | not) or (.providers | type) != "array" or (.providers | length) != 3
       or ([.providers[].id] | sort) != ["codex", "grok", "qwen"]
    then error("invalid cache") else . end
    | first(.providers[] | select(.id == $provider)) as $row
    | if $row.label != (if $provider == "codex" then "Codex" else "Grok" end)
         or ($row.state != "ready" and $row.state != "stale")
         or ($row.observedAt | epoch | not) or $row.observedAt > $now
         or ($now - $row.observedAt) >= $horizon
         or ($row.meters | type) != "array" or ($row.meters | length) != 1
      then error("ineligible cache") else $row end
    | .meters[0] as $meter
    | ($row.issue // "") as $issue
    | (if $issue == "" then ""
       elif $issue == "login-required" then "run qq-models-login " + $provider
       elif $issue == "configuration" then "check qq-models auth configuration"
       elif $issue == "provider-error" then "provider rejected usage request"
       elif $issue == "response-error" then "provider response unsupported"
       elif $issue == "temporary" then "temporary provider failure"
       else null end) as $detail
    | if $detail == null or $meter.id != "weekly" or $meter.label != "7d" or $meter.detail != $detail
         or ($meter.usedRatio | type) != "number" or ($meter.usedRatio | finite | not)
         or $meter.usedRatio < 0 or $meter.usedRatio > 1
         or (($meter.resetAt == null or ($meter.resetAt | epoch)) | not)
         or ($meter.resetAt != null and $now >= $meter.resetAt)
      then error("ineligible meter") else . end
    | [.observedAt, $meter.usedRatio, ($meter.resetAt // "")] | @tsv
  ' "$USAGE_CACHE" 2>/dev/null) || return 1
  IFS=$'\t' read -r observed ratio reset <<<"$row"
  apply_provider_usage "$provider" stale "$observed" "$ratio" "$reset" "$nowms"
}

fetch_all() {
  local now codex_access='' codex_account='' grok_access=''
  local codex_file='' grok_file='' codex_headers='' grok_headers=''
  local codex_auth_issue=login-required grok_auth_issue=login-required
  local normalized pct reset frac pid issue
  local codex_attempted=0 grok_attempted=0
  local -a pids=()
  [ "$HEADLESS" = 1 ] || load_roles
  GPT_WEEK='7d       unavailable'
  GROK_WEEK='7d       unavailable'
  CODEX_USAGE_STATE=unavailable
  CODEX_USAGE_OBSERVED_AT=''; CODEX_USAGE_RATIO=''; CODEX_USAGE_RESET_AT=''; CODEX_USAGE_ISSUE=''
  GROK_USAGE_STATE=unavailable
  GROK_USAGE_OBSERVED_AT=''; GROK_USAGE_RATIO=''; GROK_USAGE_RESET_AT=''; GROK_USAGE_ISSUE=''
  now=$(now_epoch)
  USAGE_GENERATED_AT=$((now * 1000))

  # Initialize independently from eligible last-good rows. Fresh success replaces
  # only its own row. Every failure keeps an eligible row explicitly stale with
  # a safe issue; auth/config issues remain actionable and never trigger fallback.
  load_stale_provider codex "$USAGE_GENERATED_AT" || true
  load_stale_provider grok "$USAGE_GENERATED_AT" || true

  if provider_credentials codex; then
    codex_access=$AUTH_ACCESS
    codex_account=$AUTH_ACCOUNT
  else
    codex_auth_issue=$AUTH_ISSUE
    [ "$codex_auth_issue" = missing ] && codex_auth_issue=login-required
    apply_provider_failure codex "$codex_auth_issue"
  fi
  if provider_credentials grok; then
    grok_access=$AUTH_ACCESS
  else
    grok_auth_issue=$AUTH_ISSUE
    [ "$grok_auth_issue" = missing ] && grok_auth_issue=login-required
    apply_provider_failure grok "$grok_auth_issue"
  fi

  if [ -n "$TELEMETRY_TMP" ]; then
    codex_file="$TELEMETRY_TMP/codex.json"
    grok_file="$TELEMETRY_TMP/grok.json"
    codex_headers="$TELEMETRY_TMP/codex.headers"
    grok_headers="$TELEMETRY_TMP/grok.headers"
    # The temp directory lives for the process. Never let a body/result from an
    # older cycle become a new observation when setup fails this cycle.
    rm -f -- "$codex_file" "$grok_file" "$codex_file.result" "$grok_file.result" \
      "$codex_headers" "$grok_headers"
    if [ -n "$codex_access" ] && [ -n "$codex_account" ] &&
       (umask 077; printf 'Authorization: Bearer %s\nChatGPT-Account-Id: %s\n' \
          "$codex_access" "$codex_account" >"$codex_headers") &&
       chmod 600 "$codex_headers" 2>/dev/null; then
      codex_attempted=1
      provider_api_get "$codex_file" 'https://chatgpt.com/backend-api/wham/usage' \
        -H "@$codex_headers" &
      pids+=("$!")
    fi
    if [ -n "$grok_access" ] &&
       (umask 077; printf 'Authorization: Bearer %s\n' "$grok_access" >"$grok_headers") &&
       chmod 600 "$grok_headers" 2>/dev/null; then
      grok_attempted=1
      provider_api_get "$grok_file" 'https://cli-chat-proxy.grok.com/v1/billing?format=credits' \
        -H "@$grok_headers" \
        -H "User-Agent: $GROK_USER_AGENT" \
        -H "x-grok-client-identifier: $GROK_CLIENT_IDENTIFIER" \
        -H "x-grok-client-version: $GROK_CLIENT_VERSION" \
        -H "x-grok-client-mode: $GROK_CLIENT_MODE" &
      pids+=("$!")
    fi
    for pid in "${pids[@]}"; do wait "$pid" || true; done
    rm -f -- "$codex_headers" "$grok_headers"
  fi

  if [ "$codex_attempted" = 1 ]; then
    if [ -s "$codex_file" ] && normalized=$(normalize_provider_response codex "$codex_file"); then
      IFS=$'\t' read -r pct reset <<<"$normalized"
      frac=$(awk -v value="$pct" 'BEGIN { print value / 100 }')
      apply_provider_usage codex ready "$USAGE_GENERATED_AT" "$frac" "$reset" "$USAGE_GENERATED_AT"
    elif [ -s "$codex_file" ]; then
      apply_provider_failure codex response-error
    else
      issue=$(provider_request_result "$codex_file")
      apply_provider_failure codex "$issue"
    fi
  elif [ -n "$codex_access" ]; then
    apply_provider_failure codex temporary
  fi
  if [ "$grok_attempted" = 1 ]; then
    if [ -s "$grok_file" ] && normalized=$(normalize_provider_response grok "$grok_file"); then
      IFS=$'\t' read -r pct reset <<<"$normalized"
      frac=$(awk -v value="$pct" 'BEGIN { print value / 100 }')
      apply_provider_usage grok ready "$USAGE_GENERATED_AT" "$frac" "$reset" "$USAGE_GENERATED_AT"
    elif [ -s "$grok_file" ]; then
      apply_provider_failure grok response-error
    else
      issue=$(provider_request_result "$grok_file")
      apply_provider_failure grok "$issue"
    fi
  elif [ -n "$grok_access" ]; then
    apply_provider_failure grok temporary
  fi

  qwen_update "$now"
  return 0
}

persist_usage_cache() {
  # This file is the only bridge to the in-process dashboard service. It holds
  # display data only: never credentials, raw provider payloads, or local paths.
  local state_dir tmp
  state_dir=$(dirname -- "$USAGE_CACHE")
  mkdir -p -- "$state_dir" 2>/dev/null || return 1
  tmp=$(mktemp "$state_dir/.usage-cache.XXXXXX" 2>/dev/null) || return 1
  USAGE_CACHE_TMP=$tmp
  if ! jq -cn \
      --argjson generated "$USAGE_GENERATED_AT" \
      --arg codex_state "$CODEX_USAGE_STATE" --arg codex_observed "$CODEX_USAGE_OBSERVED_AT" \
      --arg codex_ratio "$CODEX_USAGE_RATIO" --arg codex_reset "$CODEX_USAGE_RESET_AT" \
      --arg codex_issue "$CODEX_USAGE_ISSUE" \
      --arg grok_state "$GROK_USAGE_STATE" --arg grok_observed "$GROK_USAGE_OBSERVED_AT" \
      --arg grok_ratio "$GROK_USAGE_RATIO" --arg grok_reset "$GROK_USAGE_RESET_AT" \
      --arg grok_issue "$GROK_USAGE_ISSUE" \
      --arg qwen_state "$QWEN_USAGE_STATE" --arg qwen_observed "$QWEN_USAGE_OBSERVED_AT" \
      --arg qwen_weekly "$QWEN_WEEKLY_RATIO" --arg qwen_weekly_reset "$QWEN_WEEKLY_RESET_AT" \
      --arg qwen_weekly_detail "$QWEN_WEEKLY_DETAIL" --arg qwen_five "$QWEN_FIVE_RATIO" \
      --arg qwen_five_reset "$QWEN_FIVE_RESET_AT" --arg qwen_five_detail "$QWEN_FIVE_DETAIL" '
    def number_or_null($value): try ($value | tonumber) catch null;
    def issue_or_null($value): if $value == "" then null else $value end;
    def provider_detail($provider; $state; $issue):
      if $state != "stale" or $issue == "" then ""
      elif $issue == "login-required" then "run qq-models-login " + $provider
      elif $issue == "configuration" then "check qq-models auth configuration"
      elif $issue == "provider-error" then "provider rejected usage request"
      elif $issue == "response-error" then "provider response unsupported"
      elif $issue == "temporary" then "temporary provider failure"
      else "" end;
    def meter($id; $label; $ratio; $reset; $detail):
      (number_or_null($ratio)) as $used
      | if $used == null then [] else [{
          id: $id, label: $label, usedRatio: $used,
          resetAt: number_or_null($reset), detail: $detail
        }] end;
    {
      schema: "qq.dashboard-usage/v1",
      generatedAt: $generated,
      providers: [
        {id: "codex", label: "Codex", state: $codex_state, issue: issue_or_null($codex_issue),
         observedAt: number_or_null($codex_observed),
         meters: meter("weekly"; "7d"; $codex_ratio; $codex_reset;
                       provider_detail("codex"; $codex_state; $codex_issue))},
        {id: "grok", label: "Grok", state: $grok_state, issue: issue_or_null($grok_issue),
         observedAt: number_or_null($grok_observed),
         meters: meter("weekly"; "7d"; $grok_ratio; $grok_reset;
                       provider_detail("grok"; $grok_state; $grok_issue))},
        {id: "qwen", label: "Qwen", state: $qwen_state, issue: null,
         observedAt: number_or_null($qwen_observed),
         meters: (meter("weekly"; "7d"; $qwen_weekly; $qwen_weekly_reset; $qwen_weekly_detail)
           + meter("five-hour"; "5h"; $qwen_five; $qwen_five_reset; $qwen_five_detail))}
      ]
    }
  ' >"$tmp" 2>/dev/null; then
    rm -f -- "$tmp"
    USAGE_CACHE_TMP=''
    return 1
  fi
  chmod 600 "$tmp" 2>/dev/null || { rm -f -- "$tmp"; USAGE_CACHE_TMP=''; return 1; }
  mv -f -- "$tmp" "$USAGE_CACHE" 2>/dev/null || { rm -f -- "$tmp"; USAGE_CACHE_TMP=''; return 1; }
  USAGE_CACHE_TMP=''
}

headless_cycle() {
  fetch_all || return 65
  if persist_usage_cache; then
    # This exact fixed line is the entire headless stdout protocol. The Cordis
    # owner treats anything else as malformed and never logs child output.
    printf '%s\n' "$USAGE_UPDATE_SIGNAL"
  fi
  return 0
}

render() {
  local frame
  persist_usage_cache || true
  frame=$(render_body)
  if [ -t 1 ]; then printf '\033[2J\033[H'; fi
  printf '%s\n' "$frame"
  # Persist the frame so the next launch can paint it instantly while the
  # live fetch runs. Panel output carries no credential material.
  mkdir -p -- "$(dirname -- "$FRAME_FILE")" 2>/dev/null || true
  printf '%s\n' "$frame" >"$FRAME_FILE" 2>/dev/null || true
  chmod 600 "$FRAME_FILE" 2>/dev/null || true
}

render_body() {
  local sep="${C_DIM} ─────────────────────────────────────────────────────────────────────────────────────────────${C_RESET}"
  printf '%s\n' "${C_BOLD} QQ DASHBOARD${C_RESET}  ${C_DIM}updated $(date '+%H:%M:%S %Z')${C_RESET}"
  printf '%s\n' "$sep"
  printf '%s\n' "${C_BOLD} Codex${C_RESET}"
  printf '   %s\n' "$(row_or_dim "$GPT_WEEK")"
  printf '%s\n' ''
  printf '%s\n' "${C_BOLD} Grok${C_RESET}"
  printf '   %s\n' "$(row_or_dim "$GROK_WEEK")"
  printf '%s\n' ''
  printf '%s\n' "${C_BOLD} Qwen${C_RESET}"
  [ -n "$QWEN_L1" ] && printf '   %s\n' "$(row_or_dim "$QWEN_L1")"
  [ -n "$QWEN_L2" ] && printf '   %s\n' "$(row_or_dim "$QWEN_L2")"
  printf '%s\n' ''
  printf '%s\n' ''
  printf '%s\n' "${C_BOLD} Execution profiles${C_RESET}"
  [ -n "$ROLES_BODY" ] && printf '%s\n' "$(row_or_dim "$ROLES_BODY")"
  printf '%s\n' "$sep"
  printf '%s\n' "${C_DIM}r refresh · q quit · auto ${REFRESH_SECS}s · Qwen ping ${QWEN_GW_CADENCE}s${C_RESET}"
}

qq_dashboard_main() {
  case "${1:-}" in
    '') ONCE=0; HEADLESS=0 ;;
    --once) ONCE=1; HEADLESS=0 ;;
    --headless) ONCE=0; HEADLESS=1 ;;
    --help|-h) usage; return 0 ;;
    *) usage >&2; return 2 ;;
  esac
  [ "$#" -le 1 ] || { usage >&2; return 2; }
  if [ -z "$TELEMETRY_HOME" ] || [[ "$TELEMETRY_HOME" != /* ]]; then
    printf 'qq-dashboard: HOME must be absolute\n' >&2
    return 65
  fi

  if [ "$ONCE" = 1 ]; then
    fetch_all || return 65
    render
    return 0
  fi

  if [ "$HEADLESS" = 1 ]; then
    while true; do
      headless_cycle || return $?
      sleep "$REFRESH_SECS"
    done
  fi

  # Paint the last persisted frame immediately so the pane is never blank
  # while the first live fetch runs; the fetch then repaints over it.
  if [ -s "$FRAME_FILE" ]; then
    cat -- "$FRAME_FILE"
    printf '%s\n' "${C_DIM}stale frame — refreshing…${C_RESET}"
  fi

  while true; do
    fetch_all || return 65
    render
    key=''
    if [ -t 0 ]; then
      read -r -t "$REFRESH_SECS" -n1 key || key=''
    else
      sleep "$REFRESH_SECS"
    fi
    case "$key" in
      q|Q) [ -t 1 ] && printf '\033[2J\033[H'; return 0 ;;
      r|R) FORCE_QWEN=1 ;;
    esac
  done
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  qq_dashboard_main "$@"
fi

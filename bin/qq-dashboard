#!/usr/bin/env bash
# QQ operational terminal dashboard. Credential material is read only for the
# provider requests that need it and is never included in dashboard output.
set -u

SCRIPT_PATH=$(realpath -e -- "${BASH_SOURCE[0]}") || exit 1
SCRIPT_DIR=$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
# shellcheck source=bin/lib/telemetry-lib.sh
source "$SCRIPT_DIR/lib/telemetry-lib.sh"

TELEMETRY_HOME="${HOME:-}"
AUTH_FILE="${TELEMETRY_HOME}/.pi/agent/auth.json"
MODELS_AUTH_SCHEMA='qq.models-auth/v1'
CODEX_STALE_MAX_SECS=21600
GROK_STALE_MAX_SECS=21600
PROVIDER_HTTP_MAX_ATTEMPTS=2
PROVIDER_HTTP_RETRY_DELAY=.2
PROVIDER_MAX_RESPONSE_BYTES=1048576
MAX_AUTH_STORE_BYTES=65536
MAX_USAGE_CACHE_BYTES=131072
GROK_USER_AGENT='@hypermemetic-ai/qq-models/0.0.0 (+https://github.com/hypermemetic-ai/qq)'
GROK_CLIENT_IDENTIFIER='@hypermemetic-ai/qq-models'
GROK_CLIENT_VERSION='1.0.3'
GROK_CLIENT_MODE='headless'
PROFILE_COMMAND="${QQ_PROFILE_BIN:-qq-profile}"
METER_CACHE="${TELEMETRY_HOME}/.local/state/qq/telemetry/meter-cache.json"
FRAME_FILE="${TELEMETRY_HOME}/.local/state/qq/telemetry/last-frame.txt"
USAGE_CACHE="${TELEMETRY_HOME}/.local/state/qq/telemetry/usage-cache.json"
REFRESH_SECS="${TELEMETRY_REFRESH:-30}"
QWEN_GW_CADENCE="${TELEMETRY_QWEN_GW_CADENCE:-300}"
QWEN_MTR_CADENCE="${TELEMETRY_REFRESH:-30}"
QWEN_SESSION_WINDOW_DAYS=7
BAR_CELLS=16
C_RESET=$'\033[0m'
C_DIM=$'\033[2m'
C_BOLD=$'\033[1m'
C_RED=$'\033[31m'

TELEMETRY_TMP=""
USAGE_CACHE_TMP=""
AUTH_ISSUE=configuration
cleanup() {
  if [ -n "$USAGE_CACHE_TMP" ]; then rm -f -- "$USAGE_CACHE_TMP"; fi
  if [ -n "$TELEMETRY_TMP" ] && [ -d "$TELEMETRY_TMP" ]; then
    rm -rf -- "$TELEMETRY_TMP"
  fi
}
exit_on_signal() {
  local status="$1"
  trap - HUP INT TERM
  exit "$status"
}
trap cleanup EXIT
trap 'exit_on_signal 129' HUP
trap 'exit_on_signal 130' INT
trap 'exit_on_signal 143' TERM
TELEMETRY_TMP=$(mktemp -d "${TMPDIR:-/tmp}/qq-dashboard.XXXXXX" 2>/dev/null || true)

iso_local() { date -d "$1" '+%m-%d %H:%M %Z' 2>/dev/null || printf '?'; }
epoch_local() { date -d "@$1" '+%m-%d %H:%M %Z' 2>/dev/null || printf '?'; }
now_epoch() { date -u +%s; }

api_get() {
  # Qwen's existing best-effort helper. Codex/Grok use provider_api_get below,
  # which records HTTP status and retries only transient failures.
  curl -sS -m 6 -H 'Accept: application/json' "$@" 2>/dev/null || true
}

trim_path_value() {
  local value=$1
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

resolve_models_home() {
  # Match qq-models: QQ_DSH_HOME, DSH_HOME, XDG_STATE_HOME/qq, HOME default.
  # Status 2 means invalid configuration and must never fall through.
  local value
  value=$(trim_path_value "${QQ_DSH_HOME:-}")
  if [ -z "$value" ]; then value=$(trim_path_value "${DSH_HOME:-}"); fi
  if [ -z "$value" ]; then
    value=$(trim_path_value "${XDG_STATE_HOME:-}")
    [ -z "$value" ] || value="${value%/}/qq"
  fi
  [ -z "$value" ] && value="${TELEMETRY_HOME%/}/.local/state/qq"
  [ -n "$value" ] || value=/
  [[ "$value" == /* ]] && ! [[ "$value" =~ [[:cntrl:]] ]] || return 2
  value=${value%/}; [ -n "$value" ] || value=/
  local normalized
  normalized=$(realpath -m -- "$value" 2>/dev/null) || return 2
  [ "$normalized" = "$value" ] || return 2
  MODELS_HOME=$value
}

safe_regular_file() {
  # Validate every existing path component, reject all symlinks, and require a
  # current-user 0600 regular file of bounded size. Status 1 means absent.
  local file=$1 current=/ component mode owner size
  [[ "$file" == /* ]] && ! [[ "$file" =~ [[:cntrl:]] ]] || return 2
  local -a parts=()
  IFS=/ read -r -a parts <<<"${file#/}"
  for component in "${parts[@]:0:${#parts[@]}-1}"; do
    [ -n "$component" ] || continue
    current="${current%/}/$component"
    if [ ! -e "$current" ] && [ ! -L "$current" ]; then return 1; fi
    [ -d "$current" ] && [ ! -L "$current" ] || return 2
  done
  if [ ! -e "$file" ] && [ ! -L "$file" ]; then return 1; fi
  [ -f "$file" ] && [ ! -L "$file" ] && [ -r "$file" ] || return 2
  read -r mode owner size < <(stat -c '%a %u %s' -- "$file" 2>/dev/null) || return 2
  [ "$mode" = 600 ] && [ "$owner" = "${EUID:-$(id -u)}" ] || return 2
  [[ "$size" =~ ^[0-9]+$ ]] && [ "$size" -gt 0 ] && [ "$size" -le "$MAX_AUTH_STORE_BYTES" ] || return 2
}

codex_account_from_token() {
  local token=$1 payload encoded pad account
  IFS=. read -r _ encoded _ <<<"$token"
  [ -n "${encoded:-}" ] || return 1
  payload=${encoded//-/+}; payload=${payload//_/\/}
  pad=$(( (4 - ${#payload} % 4) % 4 ))
  while [ "$pad" -gt 0 ]; do payload+="="; pad=$((pad - 1)); done
  account=$(printf '%s' "$payload" | base64 -d 2>/dev/null | jq -er '
    .["https://api.openai.com/auth"].chatgpt_account_id
    | select(type == "string" and test("^[^[:space:][:cntrl:]]{1,1024}$"))
  ' 2>/dev/null) || return 1
  printf '%s' "$account"
}

models_auth_from_store() {
  # Globals AUTH_ACCESS/AUTH_ACCOUNT are caller-only credential state. Status 1
  # is an absent selected dedicated store; status 2 is present/unsafe/invalid.
  # AUTH_ISSUE is a bounded non-secret classification, never provider text.
  local connector=$1 file row nowms expires status
  AUTH_ACCESS=''; AUTH_ACCOUNT=''; AUTH_ISSUE=configuration
  resolve_models_home || return 2
  file="${MODELS_HOME%/}/.qq-${connector}-auth.json"
  if safe_regular_file "$file"; then :; else
    status=$?
    [ "$status" -eq 1 ] && AUTH_ISSUE=missing
    return "$status"
  fi
  row=$(jq -ec --arg schema "$MODELS_AUTH_SCHEMA" --arg connector "$connector" '
    def token: type == "string" and test("^[^[:space:][:cntrl:]]{1,16384}$");
    def finite: (isinfinite or isnan) | not;
    if type == "object" and .schema == $schema and .type == "oauth"
       and .connector == $connector and (.access | token) and (.refresh | token)
       and (.expires | type == "number" and finite and floor == . and . >= 0 and . <= 9007199254740991)
       and ((has("accountId") | not) or (.accountId | token and length <= 1024))
    then {access, account: (.accountId // ""), expires}
    else error("invalid auth") end
  ' "$file" 2>/dev/null) || return 2
  expires=$(jq -r '.expires' <<<"$row" 2>/dev/null) || return 2
  nowms=$(( $(now_epoch) * 1000 ))
  if ! [[ "$expires" =~ ^[0-9]+$ ]] || [ "$expires" -le "$nowms" ]; then
    AUTH_ISSUE=login-required
    return 2
  fi
  AUTH_ACCESS=$(jq -r '.access' <<<"$row" 2>/dev/null) || return 2
  AUTH_ACCOUNT=$(jq -r '.account' <<<"$row" 2>/dev/null) || { AUTH_ACCESS=''; return 2; }
  [ -n "$AUTH_ACCESS" ] || return 2
  if [ "$connector" = codex ] && [ -z "$AUTH_ACCOUNT" ]; then
    AUTH_ACCOUNT=$(codex_account_from_token "$AUTH_ACCESS") || {
      AUTH_ACCESS=''; AUTH_ISSUE=configuration; return 2;
    }
  fi
  AUTH_ISSUE=''
}

pi_auth_from_store() {
  # Read-only legacy fallback. It is considered only when the selected
  # dedicated store is absent, and receives the same path/mode/content checks.
  local connector=$1 row nowms expires status
  AUTH_ACCESS=''; AUTH_ACCOUNT=''; AUTH_ISSUE=configuration
  if safe_regular_file "$AUTH_FILE"; then :; else
    status=$?
    [ "$status" -eq 1 ] && AUTH_ISSUE=login-required
    return 2
  fi
  row=$(jq -ec --arg connector "$connector" '
    def token: type == "string" and test("^[^[:space:][:cntrl:]]{1,16384}$");
    def finite: (isinfinite or isnan) | not;
    (if $connector == "codex" then (."openai-codex" // .codex)
     else (."xai-auth" // .xai) end) as $outer
    | ($outer.oauth // $outer) as $auth
    | if ($outer | type) == "object" and ($auth | type) == "object"
         and ($auth.access | token) and ($auth.refresh | token)
         and ($auth.expires | type == "number" and finite and floor == . and . >= 0 and . <= 9007199254740991)
         and (($auth | has("accountId") | not) or ($auth.accountId | token and length <= 1024))
      then {access: $auth.access, account: ($auth.accountId // ""), expires: $auth.expires}
      else error("invalid auth") end
  ' "$AUTH_FILE" 2>/dev/null) || return 2
  expires=$(jq -r '.expires' <<<"$row" 2>/dev/null) || return 2
  nowms=$(( $(now_epoch) * 1000 ))
  if ! [[ "$expires" =~ ^[0-9]+$ ]] || [ "$expires" -le "$nowms" ]; then
    AUTH_ISSUE=login-required
    return 2
  fi
  AUTH_ACCESS=$(jq -r '.access' <<<"$row" 2>/dev/null) || return 2
  AUTH_ACCOUNT=$(jq -r '.account' <<<"$row" 2>/dev/null) || { AUTH_ACCESS=''; return 2; }
  [ -n "$AUTH_ACCESS" ] || return 2
  if [ "$connector" = codex ] && [ -z "$AUTH_ACCOUNT" ]; then
    AUTH_ACCOUNT=$(codex_account_from_token "$AUTH_ACCESS") || {
      AUTH_ACCESS=''; AUTH_ISSUE=configuration; return 2;
    }
  fi
  AUTH_ISSUE=''
}

provider_credentials() {
  local connector=$1 status
  AUTH_ISSUE=configuration
  if models_auth_from_store "$connector"; then return 0; else status=$?; fi
  [ "$status" -eq 1 ] || return 2
  pi_auth_from_store "$connector"
}

provider_api_get() {
  # Body and a fixed non-secret result classification stay in the private temp
  # directory. Bearers are supplied by caller-owned 0600 header files, never
  # process arguments. At most one bounded retry is made, never for auth/client
  # errors. No status, diagnostics, or provider body crosses this boundary.
  local output=$1 url=$2; shift 2
  local attempt=1 temporary="${output}.attempt" result="${output}.result"
  local status rc retry failure
  rm -f -- "$output" "$temporary" "$result"
  while [ "$attempt" -le "$PROVIDER_HTTP_MAX_ATTEMPTS" ]; do
    status=''; rc=0; failure=temporary
    status=$(curl -sS --connect-timeout 3 -m 6 --max-filesize "$PROVIDER_MAX_RESPONSE_BYTES" \
      -H 'Accept: application/json' -o "$temporary" -w '%{http_code}' "$@" "$url" 2>/dev/null) || rc=$?
    [[ "$status" =~ ^[0-9]{3}$ ]] || status=000
    if [ "$rc" -eq 0 ] && [[ "$status" =~ ^2[0-9][0-9]$ ]] &&
       [ -f "$temporary" ] && [ "$(stat -c %s -- "$temporary" 2>/dev/null || printf 0)" -le "$PROVIDER_MAX_RESPONSE_BYTES" ]; then
      if mv -f -- "$temporary" "$output" 2>/dev/null && chmod 600 "$output" 2>/dev/null; then
        (umask 077; printf '%s\n' success >"$result")
        return 0
      fi
      rm -f -- "$output" "$temporary"
      break
    fi
    rm -f -- "$temporary"
    retry=0
    if [ "$rc" -ne 0 ] || [[ "$status" =~ ^(408|425|429|500|502|503|504)$ ]]; then
      retry=1; failure=temporary
    elif [[ "$status" =~ ^(401|403)$ ]]; then
      failure=login-required
    else
      failure="provider-error"
    fi
    if [ "$retry" -ne 1 ] || [ "$attempt" -ge "$PROVIDER_HTTP_MAX_ATTEMPTS" ]; then break; fi
    sleep "$PROVIDER_HTTP_RETRY_DELAY"
    attempt=$((attempt + 1))
  done
  (umask 077; printf '%s\n' "$failure" >"$result")
  return 1
}

normalize_reset_timestamp() {
  # Provider reset times are modern quota timestamps. Restrict both units to
  # years 2000..3000 so an intermediate-magnitude integer is never guessed.
  local value=$1 seconds millis
  if [[ "$value" =~ ^[0-9]+$ ]]; then
    if [ "$value" -ge 946684800 ] && [ "$value" -le 32503680000 ]; then
      printf '%s' "$((value * 1000))"; return 0
    fi
    if [ "$value" -ge 946684800000 ] && [ "$value" -le 32503680000000 ]; then
      printf '%s' "$value"; return 0
    fi
    return 1
  fi
  [[ "$value" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt\ ][0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?([Zz]|[+-][0-9]{2}:[0-9]{2})$ ]] || return 1
  seconds=$(date -u -d "$value" '+%s' 2>/dev/null) || return 1
  [[ "$seconds" =~ ^[0-9]+$ ]] && [ "$seconds" -ge 946684800 ] && [ "$seconds" -le 32503680000 ] || return 1
  millis=$(date -u -d "$value" '+%s%3N' 2>/dev/null) || return 1
  [[ "$millis" =~ ^[0-9]+$ ]] || return 1
  printf '%s' "$millis"
}

normalize_provider_response() {
  # Print only normalized, presentation-neutral values: percent<TAB>reset-ms.
  # Known snake/camel variants may coexist only when they normalize identically,
  # including semantically equal seconds/milliseconds/ISO reset forms.
  local provider=$1 file=$2 row pct value normalized reset_ms=''
  local -a fields=()
  row=$(jq -er --arg provider "$provider" '
    def finite: (isinfinite or isnan) | not;
    def percent:
      if type == "number" then select(finite and . >= 0 and . <= 100)
      elif type == "string" and test("^(0|[1-9][0-9]*)([.][0-9]+)?$")
        then tonumber | select(finite and . >= 0 and . <= 100)
      else empty end;
    def timestamp:
      if type == "number" then select(finite and floor == . and . >= 0) | tostring
      elif type == "string"
        then select(test("^[0-9]+$") or test("^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt ][0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?([Zz]|[+-][0-9]{2}:[0-9]{2})$"))
      else empty end;
    def exactly_one($values):
      ($values | map(select(. != null))) as $raw
      | ($raw | map(percent)) as $valid
      | ($valid | unique) as $normalized
      | if ($raw | length) != ($valid | length) then error("invalid percent")
        elif ($normalized | length) == 1 then $normalized[0]
        elif ($normalized | length) == 0 then error("missing percent")
        else error("ambiguous percent") end;
    def timestamps($values):
      ($values | map(select(. != null))) as $raw
      | ($raw | map(timestamp)) as $valid
      | if ($raw | length) != ($valid | length) then error("invalid timestamp")
        else ($valid | unique) end;
    if type != "object" then error("invalid response")
    elif $provider == "codex" then
      ([.rate_limit.primary_window?, .rate_limit.primaryWindow?,
        .rateLimit.primary_window?, .rateLimit.primaryWindow?] | map(select(type == "object"))) as $windows
      | exactly_one([$windows[] | .used_percent?, .usedPercent?]) as $pct
      | timestamps([$windows[] | .reset_at?, .resetAt?]) as $resets
      | ([$pct] + $resets) | @tsv
    elif $provider == "grok" then
      exactly_one([.config.creditUsagePercent?, .config.credit_usage_percent?]) as $pct
      | timestamps([.config.currentPeriod.end?, .config.current_period.end?,
                    .config.billingPeriodEnd?, .config.billing_period_end?]) as $resets
      | ([$pct] + $resets) | @tsv
    else error("unknown provider") end
  ' "$file" 2>/dev/null) || return 1
  IFS=$'\t' read -r -a fields <<<"$row"
  pct=${fields[0]:-}
  [ -n "$pct" ] || return 1
  for value in "${fields[@]:1}"; do
    normalized=$(normalize_reset_timestamp "$value") || return 1
    if [ -z "$reset_ms" ]; then reset_ms=$normalized
    elif [ "$reset_ms" != "$normalized" ]; then return 1
    fi
  done
  printf '%s\t%s\n' "$pct" "$reset_ms"
}

color_frac() {
  awk -v f="$1" 'BEGIN { if (f>=0.9) print "\033[31m"; else if (f>=0.6) print "\033[33m"; else print "\033[32m" }'
}

fmt_usd() {
  awk -v v="${1:-0}" 'BEGIN { if (v+0<=0) printf "$0.00"; else if (v<1) printf "$%.4f", v; else printf "$%.2f", v }'
}

row_or_dim() {
  # Unavailable rows are failures; dim them so live data pops.
  case "$1" in
    *unavailable*) printf '%s%s%s' "${C_DIM}" "$1" "${C_RESET}" ;;
    *) printf '%s' "$1" ;;
  esac
}

exhausted_flag() {
  # Inline EXHAUSTED marker: shown when the meter is at/over capacity or a
  # quota-wall rejection is newer than the provider observation being shown.
  local frac="${1:-0}" wall="${2:-}" wall_ts="${3:-0}" observed_ts="${4:-0}"
  if [[ "$wall_ts" =~ ^[0-9]+$ && "$observed_ts" =~ ^[0-9]+$ ]] &&
     [ "$wall_ts" -gt 0 ] && [ "$observed_ts" -gt 0 ] &&
     [ "$wall_ts" -lt "$((observed_ts * 1000))" ]; then
    wall=''
  fi
  if [ -n "$wall" ] || [ "$(awk -v f="$frac" 'BEGIN { print (f>=1) ? 1 : 0 }')" = 1 ]; then
    printf '%s' "${C_RED}EXHAUSTED${C_RESET}"
  fi
}

usage() {
  cat <<'EOF'
Usage: qq-dashboard [--once|--headless] [--help]

Render QQ provider plans, usage, and execution profiles.
  --once     Fetch and render one screen, then exit.
  --headless Continuously publish the non-secret usage cache without a frame.
  --help     Show this help.

Interactive and headless modes refresh every 30 seconds by default; press r to
refresh or q to quit in interactive mode. Set TELEMETRY_REFRESH and
TELEMETRY_QWEN_GW_CADENCE to tune cadence.
EOF
}

